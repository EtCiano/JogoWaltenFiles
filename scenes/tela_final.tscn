theme = ExtResource("1_4niyf")
text = "
PArabéns por vencer o joguinho (:"
horizontal_alignment = 1

[node name="Texto1" parent="ScrollContainer/VBoxContainer" unique_id=1921259415 instance=ExtResource("2_4niyf")]
layout_mode = 2
text = "Eu não sei fazer textão emocionante, mas queria aproveitar essa tela para agradeçer muito pela amizade que tenho contigo, de verdade
Eu, escrevendo esse texto dias antes do teu aniversário, consigo ver direitinho tu falando que não merecia um jogo todo pra ti, mas saiba que isso é 100% mentira, eu e todos as pessoas que te conhecem diriam que você merece todos os presentes que recebeu e vai receber ainda.
"

[node name="Texto2" parent="ScrollContainer/VBoxContainer" unique_id=798178289 instance=ExtResource("2_4niyf")]
layout_mode = 2
text = "(mesmo que um jogo seja um presente muito foda, modestia parte)"

[node name="Texto3" parent="ScrollContainer/VBoxContainer" unique_id=529337428 instance=ExtResource("2_4niyf")]
layout_mode = 2
text = "Eu lembro nitidamente do dia que tu entrou no nosso circulo de amigos, depois daquele conflito com o grupo da carol, que tu veio perguntar se tu podia ficar no nosso grupo, e eu fiquei muito apreensivo de tu entrar, mas uma semana depois eu ja conversava contigo naturalmente, foi uma das reviravolta mais surpreendentes, e uma das mais importantes, até por que, de todas as pessoas que eu conheci no apogeu e que entraram no grupinho, você, eu e a Sophia foram as únicas pessoas que continuaram sendo amigos."

[node name="Texto4" parent="ScrollContainer/VBoxContainer" unique_id=1065004468 instance=ExtResource("2_4niyf")]
layout_mode = 2
text = "Eu fiquei com receio de que eu estava exagerando com um JOGO de presente, mas eu começei a pensar em tudo que tu fez pra mim nos quase 3 anos, como você me ajudou na troca de colégio, por que durante os primeiros mêses eu genuinamente não gostava do grupo que eu tava, e se eu não tivesse você pra conversar eu iria ter enloquecido em algumas semanas, e como você me deu uma escultura pra mim de presente esse ano, e eu decidi que você realmente merecia. "

[node name="Texto5" parent="ScrollContainer/VBoxContainer" unique_id=164211281 instance=ExtResource("2_4niyf")]
layout_mode = 2
text = "Mas enfim, novamente, muito obrigado por ser uma pessoa tão maravilhosa à 17 anos, e ter sido uma amiga melhor ainda à quase 3 (:

"

[node name="Titulo2" type="Label" parent="ScrollContainer/VBoxContainer" unique_id=130054377]
